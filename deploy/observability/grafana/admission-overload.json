        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (decision) (spooky:quota_outcomes_by_decision:rate5m{decision=~\"allowed|denied|failed_open|failed_closed\"})",
          "legendFormat": "{{decision}}",
          "refId": "A"
        }
      ],
      "title": "Quota Decisions",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
