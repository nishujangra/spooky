        {
          "expr": "sum by (backend_mode, reason) (spooky:quota_backend_health_events_by_mode_reason:rate5m)",
          "legendFormat": "{{backend_mode}} :: {{reason}}",
          "refId": "A"
        }
      ],
      "title": "Quota Backend Health",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
