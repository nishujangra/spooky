      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(spooky_upstream_request_latency_ms_bucket{outcome=\"success\",upstream=~\"${upstream:regex}\"}[30m])))",
          "legendFormat": "p50",
          "refId": "A"
        }
      ],
      "title": "P50 Latency",
      "type": "stat"
    },
