        {
          "expr": "sum(spooky:runtime_preview_attempts:rate5m)",
          "legendFormat": "preview attempts",
          "refId": "B"
        },
        {
          "expr": "sum by (result) (spooky:runtime_activation_outcomes_by_result_reason:rate5m)",
          "legendFormat": "activate {{result}}",
          "refId": "C"
